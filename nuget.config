<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    NuGet 依赖下载优先国内镜像的结论（2026-10，本机实测，与 Ceobe 一致）：
      - nuget.cdn.aliyun-inc.com  内网域名，公网解析失败
      - nuget.cdn.aliyun.com      TLS 握手失败
      - mirrors.tuna.tsinghua.edu.cn/nuget/  404，清华未提供 NuGet V3 源
    故构建期 NuGet 依赖走官方源；运行期不下载 NuGet 包（claude CLI 由用户自装）。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
