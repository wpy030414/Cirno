<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Cirno.Agents.Claude.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cirno.Agents.Claude\Cirno.Agents.Claude.csproj" />
    <ProjectReference Include="..\..\src\Cirno.Agents.Abstractions\Cirno.Agents.Abstractions.csproj" />
    <!-- 假 CLI 只作为被测进程拉起，不参与编译引用 -->
    <ProjectReference Include="..\Cirno.FakeClaude\Cirno.FakeClaude.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="fixtures\**\*.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 把假 CLI 的可执行文件拷到测试输出目录，供端到端用例拉起 -->
  <Target Name="CopyFakeClaude" AfterTargets="Build">
    <ItemGroup>
      <FakeClaudeOutput Include="$(MSBuildThisFileDirectory)..\Cirno.FakeClaude\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FakeClaudeOutput)" DestinationFolder="$(OutDir)fake-claude\" SkipUnchangedFiles="true" />
  </Target>

</Project>
