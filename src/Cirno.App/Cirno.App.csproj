<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>Cirno.App</RootNamespace>
    <AssemblyName>Cirno</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\cirno.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 标题栏图标：ms-appx:///Assets/cirno.ico -->
    <Content Include="Assets\cirno.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      版本对齐 Ceobe（WindowsAppSDK 2.5.1 / MVVM 8.4.2）。
      不显式引用 Microsoft.Windows.SDK.BuildTools：WindowsAppSDK 传递依赖要求 >= 10.0.26100.4654，
      写死更低版本会触发 NU1605 包降级。
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cirno.Agents.Abstractions\Cirno.Agents.Abstractions.csproj" />
    <ProjectReference Include="..\Cirno.Agents.Claude\Cirno.Agents.Claude.csproj" />
    <ProjectReference Include="..\Cirno.Core\Cirno.Core.csproj" />
    <ProjectReference Include="..\Cirno.Shell.Windows\Cirno.Shell.Windows.csproj" />
  </ItemGroup>

  <!--
    dotnet publish 在非打包 WinUI 应用上不会把 <AssemblyName>.pri 带进输出目录。
    缺了它，XAML 资源（含编译后的 BAML 与 Themes/ 内容）无法解析，应用启动即崩
    （Microsoft.UI.Xaml.dll 里 0xC000027B）。这里兜底拷一次。
  -->
  <Target Name="EnsurePriInPublishDirectory" AfterTargets="Publish">
    <Copy
      Condition="Exists('$(TargetDir)$(AssemblyName).pri')"
      SourceFiles="$(TargetDir)$(AssemblyName).pri"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true" />
  </Target>

  <!-- 主题产物：pnpm theme 生成 artifacts/themes/<id>/ → ms-appx:///Themes/<id>/ -->
  <ItemGroup>
    <Content Include="..\..\artifacts\themes\**\*.*"
             Link="Themes\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\theme\dist\themes.json"
             Link="Themes\themes.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
