<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      4px 网格。Fluent 2 的间距档位是 4 / 8 / 12 / 16 / 24：
      所有页面与卡片必须从这里取值，不要再写 7 / 10 / 14 / 18 这类散数。
    -->
    <x:Double x:Key="CirnoSpace4">4</x:Double>
    <x:Double x:Key="CirnoSpace8">8</x:Double>
    <x:Double x:Key="CirnoSpace12">12</x:Double>
    <x:Double x:Key="CirnoSpace16">16</x:Double>
    <x:Double x:Key="CirnoSpace24">24</x:Double>

    <!-- 页面外边距（Windows 11 大屏规范 24） -->
    <Thickness x:Key="CirnoPagePadding">24</Thickness>
    <!-- 卡片内边距 -->
    <Thickness x:Key="CirnoCardPadding">16</Thickness>
    <!-- 表格行左右内边距：表头与行必须共用，否则列会错位 -->
    <Thickness x:Key="CirnoTableRowPadding">12,0</Thickness>

    <!-- 侧边栏宽度：够放下「provider · 状态」两行而不截断 -->
    <x:Double x:Key="CirnoSidebarWidth">284</x:Double>

    <!-- 阅读宽度上限，避免超宽窗口把正文拉成一整行 -->
    <x:Double x:Key="CirnoContentMaxWidth">960</x:Double>
    <x:Double x:Key="CirnoFormMaxWidth">720</x:Double>
    <!-- 小徽标/标签圆角 -->
    <CornerRadius x:Key="CirnoChipCornerRadius">4</CornerRadius>
</ResourceDictionary>
