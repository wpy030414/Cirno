<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      卡片：Windows 11 官方 surface。
      CardBackgroundFillColorDefaultBrush + CardStrokeColorDefaultBrush + OverlayCornerRadius(8)。
      不要再用 LayerFillColorDefaultBrush 画「卡片」——那是导航层，不是卡片层。
    -->
    <Style x:Key="CirnoCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CirnoCardPadding}" />
    </Style>

    <!-- 无边框分组表面：页面内的次级分区。 -->
    <Style x:Key="CirnoGroupStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CirnoCardPadding}" />
    </Style>

    <!--
      图标按钮：透明底，悬停/按下仍用 WinUI 默认的 subtle fill。
      不要手写 Background=Transparent + BorderThickness=0 散落在页面里（悬停态会不一致）。
    -->
    <Style x:Key="CirnoSubtleIconButtonStyle" TargetType="Button"
           BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
    </Style>

    <!-- 侧栏底部的动作按钮：整行可点、透明底、左对齐。 -->
    <Style x:Key="CirnoPaneActionButtonStyle" TargetType="Button"
           BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
    </Style>

    <!-- 对话框按钮：8px 圆角（与 OverlayCornerRadius 一致），所有 ContentDialog 共用。 -->
    <Style x:Key="CirnoDialogButtonStyle" TargetType="Button"
           BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
    </Style>

    <Style x:Key="CirnoDialogAccentButtonStyle" TargetType="Button"
           BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
    </Style>

    <!--
      对话框圆角：覆盖默认模板在某些主题/宿主下的 0 圆角表现；
      代码创建的三选确认框（删除会话）也走这条。
    -->
    <Style TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        <Setter Property="PrimaryButtonStyle" Value="{StaticResource CirnoDialogAccentButtonStyle}" />
        <Setter Property="SecondaryButtonStyle" Value="{StaticResource CirnoDialogButtonStyle}" />
        <Setter Property="CloseButtonStyle" Value="{StaticResource CirnoDialogButtonStyle}" />
    </Style>

    <!-- 危险动作（删除会话）——只允许出现在菜单或二次确认里。 -->
    <Style x:Key="CirnoDangerButtonStyle" TargetType="Button"
           BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>

    <Style x:Key="CirnoDangerMenuFlyoutItemStyle" TargetType="MenuFlyoutItem"
           BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>

    <!--
      列表行：内容必须 Stretch，否则固定列宽会与表头错位；
      时间线不显示选中态，所以底色显式透明。
    -->
    <Style x:Key="CirnoListRowStyle" TargetType="ListViewItem"
           BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="CirnoTableHeaderCellStyle" TargetType="TextBlock"
           BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
</ResourceDictionary>
