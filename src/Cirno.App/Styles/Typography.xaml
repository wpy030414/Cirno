<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      字体与字阶。
      FontFamily 不接受 "Cascadia Mono,Consolas" 这种逗号回退列表：未安装 Cascadia 的机器
      会整串匹配失败并静默退回 UI 字体，所以固定用 Windows 自带的 Consolas。
    -->
    <FontFamily x:Key="CirnoMonoFont">Consolas</FontFamily>

    <!-- 页标题：Subtitle 20/28。会话名与空状态标题使用。 -->
    <Style x:Key="CirnoPageTitleStyle" TargetType="TextBlock"
           BasedOn="{StaticResource SubtitleTextBlockStyle}" />

    <!-- 区块标题：Body Strong 14/20。侧栏标题、弹层标题。 -->
    <Style x:Key="CirnoSectionTitleStyle" TargetType="TextBlock"
           BasedOn="{StaticResource BodyStrongTextBlockStyle}" />

    <!-- 正文强调：列表项主行。 -->
    <Style x:Key="CirnoBodyStrongStyle" TargetType="TextBlock"
           BasedOn="{StaticResource BodyStrongTextBlockStyle}" />

    <!-- 正文。 -->
    <Style x:Key="CirnoBodyStyle" TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}" />

    <!-- 正文次级色：说明、描述。 -->
    <Style x:Key="CirnoSecondaryTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- 辅助文字：Caption 12/16。 -->
    <Style x:Key="CirnoCaptionStyle" TargetType="TextBlock"
           BasedOn="{StaticResource CaptionTextBlockStyle}" />

    <Style x:Key="CirnoCaptionSecondaryStyle" TargetType="TextBlock"
           BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="CirnoCaptionTertiaryStyle" TargetType="TextBlock"
           BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>
</ResourceDictionary>
