<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Cirno.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏：拖拽区域与交互控件分离，右侧让出系统 caption 按钮 -->
        <Grid Grid.Row="0">
            <Grid x:Name="TitleBarDragRegion" Margin="16,0,180,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="Cirno" />
                    <Border
                        Padding="6,1"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="4">
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="M0" />
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel
                Margin="0,0,152,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <ComboBox
                    x:Name="ThemePicker"
                    MinWidth="150"
                    DisplayMemberPath="DisplayName"
                    SelectionChanged="OnThemeSelectionChanged"
                    AutomationProperties.Name="主题" />
                <ToggleButton
                    x:Name="ModeToggle"
                    Click="OnModeToggleClick"
                    Content="深色"
                    AutomationProperties.Name="明暗切换" />
            </StackPanel>
        </Grid>

        <!-- 主体：侧边栏 + 内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="16,12,12,8">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="会话" />
                        <Button
                            Padding="8,3"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="新建会话"
                            Content="+"
                            IsEnabled="False"
                            ToolTipService.ToolTip="会话管理将在 M2 接入" />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="12,0,12,0" Spacing="6">
                        <Border
                            Padding="12,10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="3">
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="还没有会话" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="M0 只搭骨架，会话与后端在 M1/M2 接入"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock
                        Grid.Row="2"
                        Margin="16,8,16,12"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="M0 · WinUI 3 骨架" />
                </Grid>
            </Border>

            <Grid
                x:Name="ContentHost"
                Grid.Column="1"
                SizeChanged="OnContentSizeChanged">

                <!-- 艺术层：仅在插画主题下可见 -->
                <Grid x:Name="ArtLayer" IsHitTestVisible="False" Visibility="Collapsed">
                    <Image
                        x:Name="BackdropImage"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Stretch="UniformToFill" />
                    <Image
                        x:Name="CharacterLeftImage"
                        Margin="0,0,0,-6"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Stretch="Uniform" />
                    <Image
                        x:Name="CharacterRightImage"
                        Margin="0,0,0,-6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Stretch="Uniform" />
                </Grid>

                <Grid>
                    <Border
                        MaxWidth="480"
                        Padding="28,24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="10">
                            <TextBlock
                                FontSize="28"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="Cirno" />
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="WinUI 3 · Fluent 2 · Mica · 原生 Agent 座舱"
                                TextWrapping="Wrap" />
                            <Rectangle
                                Height="1"
                                Margin="0,4"
                                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <TextBlock
                                x:Name="ThemeStatusText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="主题：默认（Fluent，无图片）"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="试试右上角的主题下拉框，切到「大肥鱼」。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
