<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Cirno.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Cirno.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Cirno.App.Views"
    xmlns:vm="using:Cirno.App.ViewModels"
    mc:Ignorable="d">

    <!--
      主壳（2026-10-22 Fluent 2 重构，对齐 Ceobe 的视觉体系）：
      · 内置 TitleBar 控件 + ExtendsContentIntoTitleBar：标题栏与应用同一主题、caption 区域自动避让；
      · NavigationView 承载会话导航，官方侧栏语义（选中指示 / 键盘 / 无障碍）；
      · 右侧工作区 = 会话头 + 时间线 + Composer + 状态条；
      · PageBackground 是 Mica 不可用时的纯色回退层，可用时在 code-behind 隐藏。
    -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <DataTemplate x:Key="UserItemTemplate">
                <Grid
                    MaxWidth="620"
                    Margin="0,16,0,4"
                    HorizontalAlignment="Right">
                    <Border
                        Padding="12,9"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                        <TextBlock
                            FontSize="14"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            IsTextSelectionEnabled="True"
                            LineHeight="21"
                            Text="{Binding Text}"
                            TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="AssistantItemTemplate">
                <StackPanel Margin="0,12,0,6" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock
                            Style="{StaticResource CirnoCaptionSecondaryStyle}"
                            Text="助手" />
                        <ProgressRing
                            Width="12"
                            Height="12"
                            IsActive="{Binding IsStreaming}"
                            Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <controls:MessageBody IsStreaming="{Binding IsStreaming}" Text="{Binding Text}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="ToolItemTemplate">
                <Expander
                    Margin="0,4"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border
                                Padding="6,1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="{StaticResource CirnoChipCornerRadius}">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding KindLabel}" />
                            </Border>
                            <TextBlock
                                MaxWidth="520"
                                VerticalAlignment="Center"
                                Style="{StaticResource CirnoCaptionSecondaryStyle}"
                                Text="{Binding Summary}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Expander.Header>
                    <Border
                        Margin="0,4,0,2"
                        Style="{StaticResource CodeBlockBorderStyle}"
                        Visibility="{Binding HasBody, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource CodeBlockTextStyle}" Text="{Binding Body}" />
                    </Border>
                </Expander>
            </DataTemplate>

            <DataTemplate x:Key="FileChangeItemTemplate">
                <Expander
                    Margin="0,4"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border
                                Padding="6,1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                CornerRadius="{StaticResource CirnoChipCornerRadius}">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="文件变更" />
                            </Border>
                            <TextBlock
                                MaxWidth="520"
                                VerticalAlignment="Center"
                                Style="{StaticResource CirnoCaptionSecondaryStyle}"
                                Text="{Binding Summary}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Expander.Header>
                    <controls:DiffBody
                        Margin="0,4,0,2"
                        Text="{Binding Detail}"
                        Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                </Expander>
            </DataTemplate>

            <DataTemplate x:Key="ApprovalItemTemplate">
                <Border
                    Margin="0,12,0,6"
                    Style="{StaticResource CirnoCardStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Glyph="&#xE7BA;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CirnoBodyStrongStyle}"
                                Text="需要授权" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CirnoCaptionSecondaryStyle}"
                                Text="{Binding HeaderLine}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Border
                            Style="{StaticResource CodeBlockBorderStyle}"
                            Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource CodeBlockTextStyle}" Text="{Binding Detail}" />
                        </Border>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{Binding ApprovalActionsVisibility}">
                            <Button
                                Click="OnApproveClick"
                                Content="允许"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button Click="OnDenyClick" Content="拒绝" />
                        </StackPanel>

                        <TextBlock
                            Style="{StaticResource CirnoCaptionSecondaryStyle}"
                            Text="{Binding ApprovalResultText}"
                            Visibility="{Binding ApprovalResultVisibility}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="NoticeItemTemplate">
                <TextBlock
                    Margin="0,10"
                    HorizontalAlignment="Center"
                    Style="{StaticResource CirnoCaptionTertiaryStyle}"
                    Text="{Binding Text}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </DataTemplate>

            <DataTemplate x:Key="ErrorItemTemplate">
                <Border
                    Margin="0,10"
                    Padding="14,12"
                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <TextBlock
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{Binding Text}"
                        TextWrapping="Wrap" />
                </Border>
            </DataTemplate>

            <views:TimelineTemplateSelector
                x:Key="TimelineTemplates"
                ApprovalTemplate="{StaticResource ApprovalItemTemplate}"
                AssistantTemplate="{StaticResource AssistantItemTemplate}"
                ErrorTemplate="{StaticResource ErrorItemTemplate}"
                FileChangeTemplate="{StaticResource FileChangeItemTemplate}"
                NoticeTemplate="{StaticResource NoticeItemTemplate}"
                ToolTemplate="{StaticResource ToolItemTemplate}"
                UserTemplate="{StaticResource UserItemTemplate}" />
        </Grid.Resources>

        <!-- 纯色回退层：Mica 可用时由 code-behind 隐藏 -->
        <Grid x:Name="PageBackground" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TitleBar
                x:Name="AppTitleBar"
                Grid.Row="0"
                Background="Transparent"
                IsBackButtonVisible="False"
                IsPaneToggleButtonVisible="False"
                Title="Cirno">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="ms-appx:///Assets/cirno.ico" />
                </TitleBar.IconSource>
            </TitleBar>

            <NavigationView
                x:Name="SessionNav"
                Grid.Row="1"
                AutomationProperties.Name="会话导航"
                Background="Transparent"
                CompactPaneLength="{StaticResource CirnoSidebarWidth}"
                IsBackButtonVisible="Collapsed"
                IsPaneOpen="True"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                MenuItemsSource="{x:Bind Sessions, Mode=OneWay}"
                OpenPaneLength="{StaticResource CirnoSidebarWidth}"
                PaneDisplayMode="Left"
                SelectionChanged="OnSessionSelectionChanged">

                <NavigationView.PaneHeader>
                    <Grid Padding="16,12,12,8" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource CirnoSectionTitleStyle}"
                            Text="会话" />

                        <Button
                            x:Name="NewSessionButton"
                            Grid.Column="1"
                            AutomationProperties.Name="新建会话"
                            Click="OnNewSessionClick"
                            Style="{StaticResource CirnoSubtleIconButtonStyle}"
                            ToolTipService.ToolTip="新建会话 (Ctrl+N)">
                            <FontIcon FontSize="16" Glyph="&#xE710;" />
                        </Button>

                        <Button
                            Grid.Column="2"
                            AutomationProperties.Name="在目录中新建会话"
                            Click="OnPickFolderClick"
                            Style="{StaticResource CirnoSubtleIconButtonStyle}"
                            ToolTipService.ToolTip="在选定目录中新建会话">
                            <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                        </Button>
                    </Grid>
                </NavigationView.PaneHeader>

                <!--
                  单一内联模板：行模板放在 RootGrid.Resources 里是安全的，
                  放进 App.Resources 时 NavigationView 处理集合变更会命中 WinUI 原生层崩溃。
                -->
                <NavigationView.MenuItemTemplate>
                    <DataTemplate>
                        <Grid
                            MinHeight="56"
                            Padding="10,8"
                            RowSpacing="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Margin="0,0,20,0"
                                Style="{StaticResource CirnoBodyStrongStyle}"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                Grid.Row="1"
                                Margin="0,0,20,0"
                                Style="{StaticResource CirnoCaptionSecondaryStyle}"
                                Text="{Binding SubtitleLine}"
                                TextTrimming="CharacterEllipsis" />

                            <!--
                              状态点：三态各一个圆点，靠 Visibility 切换。
                              不在代码里 new SolidColorBrush，否则切主题时颜色不跟着变。
                            -->
                            <Grid
                                Grid.RowSpan="2"
                                Width="10"
                                Height="10"
                                Margin="0,3,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                                <Ellipse
                                    Width="7"
                                    Height="7"
                                    Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                    Visibility="{Binding RunningBadgeVisibility}" />
                                <Ellipse
                                    Width="7"
                                    Height="7"
                                    Fill="{ThemeResource SystemFillColorCautionBrush}"
                                    Visibility="{Binding ApprovalBadgeVisibility}" />
                                <Ellipse
                                    Width="7"
                                    Height="7"
                                    Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                    Visibility="{Binding FailedBadgeVisibility}" />
                            </Grid>

                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="OnDeleteSessionClick"
                                        Style="{StaticResource CirnoDangerMenuFlyoutItemStyle}"
                                        Text="删除会话" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                        </Grid>
                    </DataTemplate>
                </NavigationView.MenuItemTemplate>

                <NavigationView.MenuItemContainerStyle>
                    <Style TargetType="NavigationViewItem">
                        <Setter Property="Margin" Value="8,2,8,2" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                    </Style>
                </NavigationView.MenuItemContainerStyle>

                <!-- PaneFooter 是自定义 UIElement，不参与 MenuItemTemplate，适合放静态动作。 -->
                <NavigationView.PaneFooter>
                    <StackPanel Padding="16,8,16,12" Spacing="4">
                        <Button
                            AutomationProperties.Name="外观"
                            Style="{StaticResource CirnoPaneActionButtonStyle}">
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <StackPanel Width="260" Spacing="12">
                                        <TextBlock Style="{StaticResource CirnoSectionTitleStyle}" Text="外观" />
                                        <ComboBox
                                            x:Name="ThemePicker"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="主题"
                                            DisplayMemberPath="DisplayName"
                                            Header="主题"
                                            SelectionChanged="OnThemeSelectionChanged" />
                                        <ToggleSwitch
                                            x:Name="ModeToggle"
                                            AutomationProperties.Name="深色模式"
                                            Header="深色模式"
                                            Toggled="OnModeToggled" />
                                        <TextBlock
                                            x:Name="ThemeStatusText"
                                            Style="{StaticResource CirnoCaptionTertiaryStyle}"
                                            Text="主题：默认（Fluent，不加载图片）"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE790;" />
                                <TextBlock Text="外观" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </NavigationView.PaneFooter>

                <Grid x:Name="ContentHost" SizeChanged="OnContentSizeChanged">
                    <!-- 艺术层：仅在插画主题下可见 -->
                    <Grid x:Name="ArtLayer" IsHitTestVisible="False" Visibility="Collapsed">
                        <Image
                            x:Name="BackdropImage"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Stretch="UniformToFill" />
                        <Image
                            x:Name="CharacterLeftImage"
                            Margin="0,0,0,-6"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Stretch="Uniform" />
                        <Image
                            x:Name="CharacterRightImage"
                            Margin="0,0,0,-6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Stretch="Uniform" />
                    </Grid>

                    <Grid x:Name="SessionHost">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 会话头：标题 + provider/状态/模型/用量 + 新建会话的默认后端与模型 -->
                        <Grid
                            Grid.Row="0"
                            Padding="24,12,24,8"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2">
                                <TextBlock
                                    Style="{StaticResource CirnoPageTitleStyle}"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Style="{StaticResource CirnoCaptionSecondaryStyle}"
                                    TextWrapping="Wrap">
                                    <Run Text="{Binding ProviderLabel}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding StatusText}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding ModelText}" />
                                    <Run Text="{Binding UsageText}" />
                                </TextBlock>
                                <TextBlock
                                    x:Name="WorkingDirectoryText"
                                    Style="{StaticResource CirnoCaptionTertiaryStyle}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Orientation="Horizontal"
                                Spacing="6">
                                <ComboBox
                                    x:Name="ProviderPicker"
                                    MinWidth="128"
                                    AutomationProperties.Name="后端"
                                    DisplayMemberPath="DisplayName"
                                    FontSize="12"
                                    SelectionChanged="OnProviderSelectionChanged"
                                    ToolTipService.ToolTip="新建会话使用的后端" />
                                <ComboBox
                                    x:Name="ModelPicker"
                                    MinWidth="128"
                                    AutomationProperties.Name="模型"
                                    FontSize="12"
                                    SelectionChanged="OnModelSelectionChanged"
                                    ToolTipService.ToolTip="新建会话使用的模型（模型是进程级属性，已有会话不变）" />
                            </StackPanel>
                        </Grid>

                        <!-- 时间线 -->
                        <Grid Grid.Row="1">
                            <ListView
                                x:Name="Timeline"
                                Padding="24,4,16,12"
                                IsItemClickEnabled="False"
                                ItemContainerStyle="{StaticResource CirnoListRowStyle}"
                                ItemTemplateSelector="{StaticResource TimelineTemplates}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.HorizontalScrollMode="Disabled"
                                SelectionMode="None" />

                            <StackPanel
                                x:Name="EmptyState"
                                MaxWidth="440"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontSize="28"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE8BD;" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource CirnoPageTitleStyle}"
                                    Text="开始一个新会话"
                                    TextAlignment="Center" />
                                <TextBlock
                                    Style="{StaticResource CirnoSecondaryTextStyle}"
                                    Text="左侧新建会话，或在下方描述要完成的任务。工具调用与文件变更会实时出现在这里，需要授权时就地确认。"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <Button
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    Click="OnNewSessionClick"
                                    Content="新建会话"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Grid>

                        <!-- Composer：卡片承载输入区，提示行与动作同一行 -->
                        <Grid
                            Grid.Row="2"
                            Padding="24,8,24,8">
                            <Border
                                Padding="10,8,10,8"
                                Style="{StaticResource CirnoCardStyle}">
                                <Grid RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBox
                                        x:Name="Composer"
                                        MinHeight="40"
                                        MaxHeight="168"
                                        Padding="6,4"
                                        AutomationProperties.Name="输入消息"
                                        AcceptsReturn="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        KeyDown="OnComposerKeyDown"
                                        PlaceholderText="向 Claude 提问…"
                                        TextWrapping="Wrap" />

                                    <Grid Grid.Row="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CirnoCaptionTertiaryStyle}"
                                            Text="Enter 发送 · Shift+Enter 换行 · Ctrl+K 聚焦" />

                                        <Button
                                            x:Name="SendButton"
                                            Grid.Column="1"
                                            MinWidth="72"
                                            Click="OnSendClick"
                                            IsEnabled="{Binding CanSend}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Visibility="{Binding SendVisibility}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontSize="12" Glyph="&#xE725;" />
                                                <TextBlock FontSize="12" Text="发送" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            x:Name="StopButton"
                                            Grid.Column="2"
                                            MinWidth="72"
                                            Click="OnStopClick"
                                            Visibility="{Binding StopVisibility}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontSize="12" Glyph="&#xE71A;" />
                                                <TextBlock FontSize="12" Text="停止" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 全局状态条：会话聚合状态，不抢占内容区 -->
                        <Border
                            Grid.Row="3"
                            Padding="24,6"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                            <TextBlock
                                x:Name="ShellStatusText"
                                AutomationProperties.LiveSetting="Polite"
                                Style="{StaticResource CirnoCaptionSecondaryStyle}"
                                Text="就绪" />
                        </Border>
                    </Grid>
                </Grid>
            </NavigationView>
        </Grid>
    </Grid>
</Window>
