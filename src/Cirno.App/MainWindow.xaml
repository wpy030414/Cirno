<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Cirno.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Cirno.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Cirno.App.Views"
    mc:Ignorable="d">



    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <DataTemplate x:Key="UserItemTemplate">
                <Grid
                    Margin="0,14,0,4"
                    HorizontalAlignment="Right"
                    MaxWidth="620">
                    <Border
                        Padding="14,9"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="10">
                        <TextBlock
                            FontSize="13.5"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            IsTextSelectionEnabled="True"
                            LineHeight="21"
                            Text="{Binding Text}"
                            TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="AssistantItemTemplate">
                <StackPanel Margin="0,10,0,6" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock
                            CharacterSpacing="60"
                            FontWeight="SemiBold"
                            Style="{StaticResource MetaTextStyle}"
                            Text="CLAUDE" />
                        <ProgressRing
                            Width="12"
                            Height="12"
                            IsActive="{Binding IsStreaming}"
                            Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <controls:MessageBody Text="{Binding Text}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="ToolItemTemplate">
                <Expander
                    Margin="0,3"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border
                                Padding="6,1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="4">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding KindLabel}" />
                            </Border>
                            <TextBlock
                                MaxWidth="520"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding Summary}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Expander.Header>
                    <Border
                        Margin="0,4,0,2"
                        Style="{StaticResource CodeBlockBorderStyle}"
                        Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource CodeBlockTextStyle}" Text="{Binding Detail}" />
                    </Border>
                </Expander>
            </DataTemplate>

            <DataTemplate x:Key="ApprovalItemTemplate">
                <Border
                    Margin="0,10,0,6"
                    Padding="14,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Glyph="&#xE7BA;" />
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="需要授权"
                                VerticalAlignment="Center" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{Binding HeaderLine}" />
                        </StackPanel>

                        <Border
                            Style="{StaticResource CodeBlockBorderStyle}"
                            Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource CodeBlockTextStyle}" Text="{Binding Detail}" />
                        </Border>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{Binding ApprovalActionsVisibility}">
                            <Button
                                Click="OnApproveClick"
                                Content="允许"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button Click="OnDenyClick" Content="拒绝" />
                        </StackPanel>

                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{Binding ApprovalResultText}"
                            Visibility="{Binding ApprovalResultVisibility}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="NoticeItemTemplate">
                <TextBlock
                    Margin="0,8"
                    HorizontalAlignment="Center"
                    Style="{StaticResource MetaTextStyle}"
                    Text="{Binding Text}"
                    TextWrapping="Wrap" />
            </DataTemplate>

            <DataTemplate x:Key="ErrorItemTemplate">
                <Border
                    Margin="0,8"
                    Padding="12,10"
                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <TextBlock
                        FontSize="12.5"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{Binding Text}"
                        TextWrapping="Wrap" />
                </Border>
            </DataTemplate>

            <views:TimelineTemplateSelector
                x:Key="TimelineTemplates"
                ApprovalTemplate="{StaticResource ApprovalItemTemplate}"
                AssistantTemplate="{StaticResource AssistantItemTemplate}"
                ErrorTemplate="{StaticResource ErrorItemTemplate}"
                NoticeTemplate="{StaticResource NoticeItemTemplate}"
                ToolTemplate="{StaticResource ToolItemTemplate}"
                UserTemplate="{StaticResource UserItemTemplate}" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏：拖拽区域与交互控件分离，右侧让出系统 caption 按钮 -->
        <Grid Grid.Row="0">
            <Grid x:Name="TitleBarDragRegion" Margin="16,0,180,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="Cirno" />
                    <Border
                        Padding="6,1"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="4">
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="M1" />
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel
                Margin="0,0,152,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <ComboBox
                    x:Name="ThemePicker"
                    MinWidth="132"
                    DisplayMemberPath="DisplayName"
                    SelectionChanged="OnThemeSelectionChanged"
                    AutomationProperties.Name="主题" />
                <ToggleButton
                    x:Name="ModeToggle"
                    Click="OnModeToggleClick"
                    Content="深色"
                    AutomationProperties.Name="明暗切换" />
            </StackPanel>
        </Grid>

        <!-- 主体：侧边栏 + 内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="16,12,12,8">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="会话" />
                        <Button
                            Padding="8,3"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="新建会话"
                            Content="+"
                            IsEnabled="False"
                            ToolTipService.ToolTip="多会话管理将在 M2 接入" />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="12,0,12,0" Spacing="6">
                        <Border
                            Padding="12,10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse
                                        Width="7"
                                        Height="7"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource SystemFillColorAttentionBrush}" />
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Text="当前会话"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    FontSize="11.5"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{Binding WorkingDirectory}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="16,8,16,12" Spacing="2">
                        <TextBlock
                            x:Name="ThemeStatusText"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="主题：默认（Fluent，无图片）"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="M1 · Claude Code 单会话" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid
                x:Name="ContentHost"
                Grid.Column="1"
                SizeChanged="OnContentSizeChanged">

                <!-- 艺术层：仅在插画主题下可见 -->
                <Grid x:Name="ArtLayer" IsHitTestVisible="False" Visibility="Collapsed">
                    <Image
                        x:Name="BackdropImage"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Stretch="UniformToFill" />
                    <Image
                        x:Name="CharacterLeftImage"
                        Margin="0,0,0,-6"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Stretch="Uniform" />
                    <Image
                        x:Name="CharacterRightImage"
                        Margin="0,0,0,-6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Stretch="Uniform" />
                </Grid>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 会话状态条 -->
                    <Grid Grid.Row="0" Padding="24,8,24,4">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="{Binding StatusText}" />
                            <Rectangle
                                Width="1"
                                Height="12"
                                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding ModelText}" />
                            <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding UsageText}" />
                        </StackPanel>

                        <StackPanel
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Padding="10,2"
                                Click="OnPickFolderClick"
                                Content="工作目录…"
                                FontSize="12"
                                ToolTipService.ToolTip="更换目录会重建后端会话（provider 是进程级属性）" />
                        </StackPanel>
                    </Grid>

                    <!-- 时间线 -->
                    <Grid Grid.Row="1">
                        <ListView
                            x:Name="Timeline"
                            Padding="24,4,16,12"
                            IsItemClickEnabled="False"
                            ItemTemplateSelector="{StaticResource TimelineTemplates}"
                            SelectionMode="None"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.HorizontalScrollMode="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <StackPanel
                            x:Name="EmptyState"
                            MaxWidth="440"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="Cirno" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="WinUI 3 · Fluent 2 · Mica · 原生 Agent 座舱"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="在下方输入任务，工具调用会在这里实时出现，需要授权时就地确认。"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!-- Composer -->
                    <StackPanel Grid.Row="2" Padding="24,0,24,18" Spacing="6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="Composer"
                                MaxHeight="168"
                                AcceptsReturn="True"
                                AutomationProperties.Name="输入消息"
                                KeyDown="OnComposerKeyDown"
                                PlaceholderText="向 Claude 提问…（Enter 发送，Shift+Enter 换行）"
                                TextWrapping="Wrap" />

                            <Button
                                x:Name="SendButton"
                                Grid.Column="1"
                                MinWidth="72"
                                Click="OnSendClick"
                                IsEnabled="{Binding CanSend}"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="{Binding SendVisibility}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE725;" />
                                    <TextBlock FontSize="12" Text="发送" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="StopButton"
                                Grid.Column="2"
                                MinWidth="72"
                                Click="OnStopClick"
                                Visibility="{Binding StopVisibility}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE71A;" />
                                    <TextBlock FontSize="12" Text="停止" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
