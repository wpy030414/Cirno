<Project>
  <!--
    版本号唯一权威，CalVer YY.MM.DD-HH。见 docs/DECISIONS.md ADR-137。

    当前值写作三段 26.10.26：三段同时用于展示与 MSI ProductVersion。
    同一天需要多次发布时，可写成**点分四段** 26.10.26.01 —— 但不能写成
    `26.10.26-01`：NuGet 按 SemVer2 拒绝数字前导零的 prerelease 标识，restore 会直接失败。
        权威（本项目内部）= 26.10.26 或 26.10.26.01
        展示（MSI 文件名/Release tag）= 26.10.26 或 26.10.26-01
        MSI ProductVersion = 前三段（Windows Installer 只接受 1–3 段数字）
  -->
  <PropertyGroup>
    <Version>26.10.26</Version>
    <Authors>xrl</Authors>
    <Product>Cirno</Product>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
